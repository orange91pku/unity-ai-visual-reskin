{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hydracore.dev/schemas/hydra-theme.schema.json",
  "type": "object",
  "required": ["schemaVersion", "themeId", "displayName", "version", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "themeId": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "styleTags": { "type": "array", "items": { "type": "string" } },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["semanticRole", "assetGuid", "spriteName"],
        "properties": {
          "semanticRole": { "type": "string", "minLength": 1 },
          "assetGuid": { "type": "string", "pattern": "^[a-fA-F0-9]{32}$" },
          "spriteName": { "type": "string", "minLength": 1 },
          "imageMode": { "enum": ["auto", "simple", "sliced", "filled"] },
          "preserveAspect": { "type": "boolean" },
          "scale": { "type": "number", "exclusiveMinimum": 0 },
          "border": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "number", "minimum": 0 }
          },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}

